# Local development only. Generate PAYLOAD_SECRET: openssl rand -hex 32
DATABASE_URL=postgresql://lunia:lunia_local_only@127.0.0.1:5432/lunia
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Explicit sample-only preview; CMS routes unavailable. Never use for production.
LUNIA_SHOWCASE=false
# Bootstrap commands only; never NEXT_PUBLIC_ or committed credentials.
SEED_EMAIL=
SEED_PASSWORD=

# Hosted preview: set ONLY after resource/access approval, on the exact allowed branch.
# Do not copy live values into this file. Keep Vercel deployment disabled until gates pass.
LUNIA_CMS_PREVIEW=false
LUNIA_CMS_BRANCH=feature/hosted-cms-preview
LUNIA_PREVIEW_REVIEW=
LUNIA_STORAGE=
CMS_ORIGIN=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
MAIL_FROM=
PREVIEW_EDITOR_EMAIL=
# Operator session only; non-secret target must equal DATABASE_URL hostname + /database.
LUNIA_OPERATOR_TARGET=
LUNIA_BACKUP_REFERENCE=
