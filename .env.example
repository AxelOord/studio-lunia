# Local development only. Generate PAYLOAD_SECRET: openssl rand -hex 32
DATABASE_URL=postgresql://lunia:lunia_local_only@127.0.0.1:5432/lunia
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Explicit sample-only preview; CMS routes unavailable. Never use for production.
LUNIA_SHOWCASE=false
# Bootstrap commands only; never NEXT_PUBLIC_ or committed credentials.
SEED_EMAIL=
SEED_PASSWORD=

# Hosted preview: provider-managed Preview settings only after approval.
# Do not copy live values into this file. See docs/full-cms-preview-runbook.md.
LUNIA_CMS_PREVIEW=false
LUNIA_PREVIEW_REVIEW=
LUNIA_STORAGE=
# Optional local origin only; hosted uses VERCEL_BRANCH_URL.
CMS_ORIGIN=
# Native Neon injects this for build-time migrations (never copy locally).
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
MAIL_FROM=
PREVIEW_EDITOR_EMAIL=
# Operator session only; non-secret target must equal DATABASE_URL hostname + /database.
LUNIA_OPERATOR_TARGET=
LUNIA_BACKUP_REFERENCE=

# Optional analytics: disabled until exact PostHog EU project/terms/access approval.
# Preview-only provider UI handoff; never export live credentials to chat or repo.
LUNIA_POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=

# Optional Resend delivery callbacks: leave disabled until narrow public ingress,
# account-wide event scope and secure signing-secret handoff are explicitly approved.
LUNIA_RESEND_WEBHOOKS_ENABLED=false
# RESEND_WEBHOOK_SECRET=
