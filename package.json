{
  "name": "studio-lunia",
  "version": "0.1.0",
  "description": "Studio Lunia photography website foundation",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "payload build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "payload": "payload",
    "db:migrate": "payload migrate",
    "db:migrate:create": "payload migrate:create",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run --project unit --outputFile.junit=test-results/unit.xml",
    "test:integration": "vitest run --project integration --outputFile.junit=test-results/integration.xml",
    "test:e2e": "node --import tsx scripts/run-browser-tests.ts",
    "spec:check": "python3 scripts/specflow.py check --ready",
    "check": "npm run check:static && npm run test:unit && npm run test:tooling",
    "postinstall": "patch-package",
    "test:workflow": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:showcase": "npm run test:e2e -- --project showcase",
    "test:upload-trace": "npm run test:build",
    "preview:operator": "tsx scripts/preview-operator.ts",
    "preview:inventory": "tsx scripts/preview-inventory.ts",
    "preview:setup": "python3 scripts/preview-setup.py",
    "preview:connection": "python3 scripts/preview-connection.py",
    "build:preview": "tsx scripts/preview-build.ts",
    "test:upload-metadata": "npm run test:e2e -- --project private-upload",
    "prepare": "node .husky/install.mjs",
    "staged:check": "lint-staged",
    "commit:check": "node scripts/check-commits.mjs",
    "test:hooks": "node --import tsx --test tests/commit-workflow.test.ts",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test:release": "node --test tests/release-automation.test.mjs",
    "test:unit": "vitest run --project unit --outputFile.junit=test-results/unit.xml",
    "test:build": "vitest run --project build --outputFile.junit=test-results/build.xml",
    "check:static": "npm run spec:check && npm run lint && npm run typecheck && npm run format:check",
    "test:tooling": "npm run test:workflow && npm run test:hooks && npm run test:release && npm run test:cleanup",
    "check:generated": "git diff --exit-code -- src/payload-types.ts \"src/app/(payload)/admin/importMap.js\"",
    "verify": "npm run generate:types && npm run generate:importmap && npm run check && npm run test:integration && npm run build && npm run check:generated && npm run test:build && npm run test:e2e",
    "test:cleanup": "node --test tests/preview-cleanup.test.mjs tests/preview-ownership.test.mjs",
    "preview:cleanup": "node scripts/preview-cleanup.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-canary.37",
    "@payloadcms/email-resend": "4.0.0-canary.37",
    "@payloadcms/live-preview-react": "4.0.0-canary.37",
    "@payloadcms/next": "4.0.0-canary.37",
    "@payloadcms/plugin-cloud-storage": "4.0.0-canary.37",
    "@payloadcms/ui": "4.0.0-canary.37",
    "@vercel/blob": "2.8.0",
    "dotenv": "16.4.7",
    "graphql": "16.11.0",
    "next": "16.3.8",
    "payload": "4.0.0-canary.37",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.12.3",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "patch-package": "8.0.1",
    "prettier": "3.6.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "private": true,
  "packageManager": "npm@11.9.0"
}
